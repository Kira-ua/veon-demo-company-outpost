---
import Section from "./Section.astro";
import { cities, phones } from "../data/site";

// Simple equirectangular projection for the scheme of Lviv oblast (schematic outline, not a survey map).
const K = 300;
const COS = Math.cos((49.7 * Math.PI) / 180);
const px = (lon: number) => Math.round((lon - 22.5) * K * COS);
const py = (lat: number) => Math.round((50.85 - lat) * K);
const outline: [number, number][] = [
  [24.05, 50.75], [24.4, 50.7], [24.65, 50.55], [25.05, 50.45], [25.35, 50.2], [25.25, 49.95], [25.0, 49.75],
  [24.7, 49.55], [24.45, 49.35], [24.15, 49.2], [23.95, 49.0], [23.7, 48.8], [23.45, 48.72], [23.2, 48.85],
  [22.95, 48.95], [22.65, 49.1], [22.62, 49.5], [22.95, 49.8], [23.25, 50.0], [23.5, 50.2], [23.7, 50.4], [23.95, 50.6],
];
const outlinePath = "M" + outline.map(([lon, lat]) => `${px(lon)} ${py(lat)}`).join(" L") + " Z";

// Label placement around the dense Drohobych / Boryslav / Truskavets cluster.
const place: Record<string, { dx: number; dy: number; anchor: "start" | "middle" | "end" }> = {
  "Львів": { dx: 18, dy: 10, anchor: "start" },
  "Червоноград": { dx: 14, dy: 7, anchor: "start" },
  "Мостиська": { dx: 0, dy: -16, anchor: "middle" },
  "Дрогобич": { dx: 12, dy: -8, anchor: "start" },
  "Борислав": { dx: -12, dy: 4, anchor: "end" },
  "Трускавець": { dx: 4, dy: 30, anchor: "end" },
  "Стрий": { dx: 12, dy: 10, anchor: "start" },
};
const pts = cities.map((c) => ({ ...c, x: px(c.lon), y: py(c.lat), isBase: "base" in c && c.base }));
const base = pts.find((p) => p.isBase)!;
---
<Section id="coverage" class="coverage on-dark" rec="UX-R005">
  <div class="container">
    <h2 class="section-title coverage__title">Де працюють наші групи реагування</h2>
    <div class="coverage__grid">
      <figure class="coverage__map" data-map>
        <svg viewBox="0 0 600 680" role="img" aria-label="Схема Львівської області: чергова частина у Львові та групи швидкого реагування в Мостиськах, Дрогобичі, Бориславі, Трускавці, Стрию і Червонограді" style={`--ox:${base.x}px;--oy:${base.y}px`}>
          <path class="map__outline" d={outlinePath} />
          <g class="map__net">
            {pts.filter((p) => !p.isBase).map((p) => <line class="map__link" x1={base.x} y1={base.y} x2={p.x} y2={p.y} />)}
            {pts.filter((p) => !p.isBase).map((p) => <circle class="map__dot" cx={p.x} cy={p.y} r="6" />)}
          </g>
          <circle class="map__base" cx={base.x} cy={base.y} r="12" />
          <circle class="map__base-core" cx={base.x} cy={base.y} r="4" />
          <g class="map__labels">
            {pts.map((p, i) => (
              <text data-label={i} class:list={["map__label", { "map__label--base": p.isBase }]} x={p.x + place[p.name].dx} y={p.y + place[p.name].dy} text-anchor={place[p.name].anchor}>{p.name}</text>
            ))}
          </g>
        </svg>
        <figcaption class="coverage__caption">Схема: розташування міст умовне, межа області спрощена.</figcaption>
      </figure>
      <div class="coverage__side">
        <ol class="route" aria-label="Міста, де працюють групи швидкого реагування">
          {pts.map((p, i) => (
            <li data-stop={i} class:list={["route__stop", { "is-base": p.isBase }]}>
              <span class="route__name">{p.name}</span>
              {p.isBase && <span class="route__note">база, цілодобова чергова частина</span>}
            </li>
          ))}
        </ol>
        <ul class="coverage__facts">
          <li>Цілодобова чергова частина у Львові, вул. Коцюбинського, 6</li>
          <li>Радіомережа по всьому місту</li>
          <li>Розширюємо покриття на передмістя Львова та інші міста області</li>
        </ul>
        <p class="coverage__ask">Ваш об’єкт в іншому населеному пункті? Уточніть телефоном: <a class="inline-phone inline-phone--on-dark" href={phones.free.href}>{phones.free.display}</a></p>
      </div>
    </div>
  </div>
</Section>
