---
import FutureLink from "./FutureLink.astro";
import PostLine from "./PostLine.astro";
import { phones, email, address, socials, legalName, NOTE } from "../data/site";
const year = 2026;
---
<footer class="site-footer">
  <div class="container">
    <PostLine variant="footer" label="Групи швидкого реагування" />
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__name">Аутпост</p>
        <p class="site-footer__legal">{legalName}</p>
        <p class="site-footer__muted">{address.display}</p>
      </div>
      <ul class="site-footer__phones">
        <li><a href={phones.free.href} class="num">{phones.free.display}</a> <span>безкоштовно</span></li>
        <li><a href={phones.duty.href} class="num">{phones.duty.display}</a> <span>черговий</span></li>
        <li><a href={phones.office.href} class="num">{phones.office.display}</a> <span>офіс</span></li>
        <li><a href={email.href}>{email.display}</a></li>
      </ul>
      <ul class="site-footer__links">
        <li><FutureLink note={NOTE}>Публічний договір</FutureLink></li>
        <li><FutureLink note={NOTE}>Політика конфіденційності</FutureLink></li>
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.name}<span class="visually-hidden"> (відкриється в новій вкладці)</span></a></li>)}
      </ul>
    </div>
    <p class="site-footer__copy">© {year} {legalName}</p>
  </div>
</footer>
