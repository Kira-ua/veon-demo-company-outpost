---
// Functional line icons only (phone, map, mail, socials, cabinet, menu). 1.75 px stroke, currentColor.
interface Props { name: "phone" | "pin" | "mail" | "facebook" | "instagram" | "youtube" | "user" | "menu" | "close" | "external"; size?: number; class?: string; }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 7 7l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />}
  {name === "pin" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === "mail" && <><rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>}
  {name === "facebook" && <><rect x="3.5" y="3.5" width="17" height="17" rx="3" /><path d="M15.5 8h-1.8a1.7 1.7 0 0 0-1.7 1.7V20.5M10 12.5h5" /></>}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><path d="M17 7h.01" /></>}
  {name === "youtube" && <><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="m10 9.2 5 2.8-5 2.8Z" /></>}
  {name === "user" && <><circle cx="12" cy="8.5" r="3.8" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
</svg>
